# Local development only. Create this database and its roles first; see
# docs/neon-initialization.md. Replace placeholders locally, never in Git.
NODE_ENV=development
PORT=3001
CLIENT_URL=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-local-signing-secret
JWT_EXPIRES_IN=15m

DATABASE_URL=postgresql://tj_backend:replace-me@localhost:5432/trading_journal
DATABASE_ROLE=tj_owner
DATABASE_SSL_MODE=disable
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=8000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_STATEMENT_TIMEOUT_MS=30000
DATABASE_IDLE_TRANSACTION_TIMEOUT_MS=30000

# Operator-only direct connection; never needed by the deployed API.
MIGRATION_DATABASE_URL=postgresql://tj_migrator:replace-me@localhost:5432/trading_journal
MIGRATION_DATABASE_ROLE=tj_owner
MIGRATION_DATABASE_SSL_MODE=disable
MIGRATION_STATEMENT_TIMEOUT_MS=120000

# Remote/Neon: use direct DNS endpoints and verify-full for BOTH SSL modes.
# Omit URL query parameters, or use only sslmode=verify-full.
# Optional private CA files (normal Neon certificates use Node's trusted roots):
# DATABASE_SSL_CA_FILE=/secure/path/ca.pem
# MIGRATION_DATABASE_SSL_CA_FILE=/secure/path/ca.pem
# Optional live quote provider; keep server-only:
# FINNHUB_API_KEY=
