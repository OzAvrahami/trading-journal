# ============================================================
# Dependencies
# ============================================================
node_modules/
**/node_modules/
.pnp
.pnp.js
.yarn/install-state.gz

# ============================================================
# Environment files  — NEVER commit secrets
# ============================================================
.env
.env.*
**/.env
**/.env.*

# Keep the examples
!.env.example
!**/.env.example

# ============================================================
# Build outputs
# ============================================================
dist/
**/dist/
build/
**/build/
out/
.output/
client/dist/
client/build/

# ============================================================
# Logs
# ============================================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ============================================================
# Runtime / temp
# ============================================================
pids/
*.pid
*.seed
*.pid.lock
*.tmp
*.temp
.tmp/
tmp/
temp/

# ============================================================
# Testing & coverage
# ============================================================
coverage/
**/coverage/
*.lcov
.nyc_output/
test-results/
playwright-report/
/blob-report/
/playwright/.cache/
.vitest/

# ============================================================
# Vite / bundler caches
# ============================================================
.vite/
.cache/
**/.cache/
*.tsbuildinfo

# ============================================================
# Package manager locks (keep only one — npm here)
# ============================================================
yarn.lock
pnpm-lock.yaml
# Uncomment the line below if you use yarn or pnpm instead:
# package-lock.json

# ============================================================
# OS generated files
# ============================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ============================================================
# IDE / Editor
# ============================================================
# Local editor state only; shared project settings may still be committed.
.idea/workspace.xml
.idea/tasks.xml
.idea/shelf/
*.iws
.vscode/*.local.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*.swo

# ============================================================
# Optional: local dev database dumps / exports
# ============================================================
*.sql.bak
*.dump
exports/
server/.local/demo-seed-backups/

# Local Codex/Claude settings; other .claude files remain shareable.
.claude/

